# Discord Bot Token（Discord Developer Portal → Bot → Reset Token 取得）
DISCORD_TOKEN=

# 私人頻道要建立在哪個分類底下（開發者模式下右鍵分類 → 複製 ID）
CATEGORY_ID=

# 管理員身分組 ID（開發者模式下右鍵該身分組 → 複製 ID）
ADMIN_ROLE_ID=

# 開發用：填了就只同步指令到這個伺服器（秒生效）
# 留空則全域同步（最長可能需要 1 小時才生效）
GUILD_ID=

# --- 以下為選填，不填則使用預設值 ---

# SQLite 資料庫路徑
DB_PATH=data/channels.db

# 日誌等級：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
